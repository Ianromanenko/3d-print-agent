# Bambu Cloud credentials (legacy web-wizard, Phase 2)
BAMBU_EMAIL=
BAMBU_PASSWORD=
BAMBU_PRINTER_SERIAL=
BAMBU_ACCESS_CODE=

# --- 3D Print Agent (local, on-demand) ---
# Bambu A1 in LAN Mode + Developer Mode. Fill from the printer screen.
A1_IP=                       # printer LAN IP, e.g. 192.168.1.50
A1_SERIAL=                   # printer serial number
A1_ACCESS_CODE=              # LAN access code (also used as MQTT/FTPS password)

# Headless slicer (Bambu Studio CLI). Auto-detected if empty.
BAMBU_STUDIO_BIN=/Applications/BambuStudio.app/Contents/MacOS/BambuStudio

# Organic-mesh generation (optional; only needed for figurine/organic requests)
MESHY_API_KEY=
